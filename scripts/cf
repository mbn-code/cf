#!/usr/bin/env bash

################################################################################
# cf - Codeforces CLI Tool
#
# Main command-line interface for C++ competitive programming.
#
# Usage:
#   cf template <name> [--from T]  - Create a new problem directory
#   cf <name|file> [input]         - Compile and run a solution
#   cf test [name]                 - Run every sample in problem.txt
#   cf stress [name] [-n N]        - Solution vs brute force on generated input
#   cf samples [name]              - Print the parsed samples
#   cf watch [name]                - Re-run the samples whenever a file changes
#   cf serve [name]                - Start the web workbench
#   cf doctor                      - Check the toolchain
#   cf clean                       - Drop the build cache
#   cf update                      - Pull the latest version
#
# Examples:
#   cf template 1000A              - Create ./1000A with solution.cpp + problem.txt
#   cf 1000A                       - Run src/1000A (or ./1000A) against sample #1
#   cf 1000A "5\n1 2 3 4 5"        - Run with inline stdin
#   cf problem.txt --sample 2      - Run sample #2 of problem.txt
#   cf test --checker tokens       - Compare whitespace-insensitively
#   cf stress -n 500               - Run 500 iterations of brute.cpp vs solution
#
# Features:
#   - Auto-detects .cpp files and problem.txt in the working directory
#   - Timeout protection, per-sample timing, build cache
#   - Line and token output checkers
#   - Cross-platform (Linux / macOS / WSL / Git Bash)
#
################################################################################

set -euo pipefail

CF_VERSION="1.0.0"

# ==================== CONFIGURATION ====================

# Determine repository root (handle symlinks)
if [ -f "${BASH_SOURCE[0]}" ]; then
    SCRIPT_PATH="${BASH_SOURCE[0]}"
    if command -v readlink &> /dev/null; then
        SCRIPT_PATH="$(readlink -f "$SCRIPT_PATH" 2>/dev/null || printf '%s' "$SCRIPT_PATH")"
    fi
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
    # If script is in the repo's scripts/ directory, use it
    if [ -f "$SCRIPT_DIR/../src/template.cpp" ]; then
        REPO_ROOT="$(dirname "$SCRIPT_DIR")"
    # Otherwise, use HOME-based fallback for global installation
    else
        REPO_ROOT="${CF_REPO_ROOT:-$HOME/Documents/GitHub/cf}"
    fi
else
    REPO_ROOT="${CF_REPO_ROOT:-$HOME/Documents/GitHub/cf}"
fi

SRC_DIR="$REPO_ROOT/src"
INCLUDE_DIR="$REPO_ROOT/include"
SCRIPTS_DIR="$REPO_ROOT/scripts"
BUILD_DIR="$REPO_ROOT/build"
TEMPLATES_DIR="$REPO_ROOT/templates"

# Compiler selection: CF_CXX/CXX override, then g++, then clang++
if [ -n "${CF_CXX:-${CXX:-}}" ] && command -v "${CF_CXX:-${CXX:-}}" &> /dev/null; then
    COMPILER="${CF_CXX:-${CXX:-}}"
elif command -v g++ &> /dev/null; then
    COMPILER="g++"
elif command -v clang++ &> /dev/null; then
    COMPILER="clang++"
else
    printf '%s\n' "Error: No C++ compiler found. Install g++ or clang++." >&2
    exit 1
fi

# Compiler flags for competitive programming
CXXFLAGS_DEFAULT="-std=c++23 -O2 -Wall -Wextra"

# Execution timeout (seconds)
EXEC_TIMEOUT_DEFAULT=5

# Color codes (disabled when not a TTY or NO_COLOR is set)
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    DIM='\033[2m'
    NC='\033[0m'
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    DIM=''
    NC=''
fi

# Logging
VERBOSE=${CF_VERBOSE:-0}

# Exit codes
EXIT_USAGE=2
EXIT_IO=3
EXIT_COMPILE=4
EXIT_UPDATE=6

# Config overrides (optional)
CF_CONFIG_FILE="${CF_CONFIG:-$REPO_ROOT/.cfconfig}"
if [ -f "$CF_CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$CF_CONFIG_FILE"
fi

# Global variable to store compiler warnings
COMPILATION_WARNINGS=""

# Effective configuration
CXXFLAGS="${CF_CXXFLAGS:-$CXXFLAGS_DEFAULT}"
EXEC_TIMEOUT="${CF_TIMEOUT:-$EXEC_TIMEOUT_DEFAULT}"
BUILD_CACHE_DIR="${CF_BUILD_CACHE_DIR:-$BUILD_DIR/.cache}"
# Output checker: "lines" (exact lines, trailing whitespace ignored) or
# "tokens" (whitespace-insensitive, like the Codeforces wcmp checker).
CHECKER="${CF_CHECKER:-lines}"

# ==================== HELPER FUNCTIONS ====================

print_error() {
    printf '%b\n' "${RED}Error: $1${NC}" >&2
}

print_success() {
    printf '%b\n' "${GREEN}Success: $1${NC}"
}

print_warning() {
    printf '%b\n' "${YELLOW}Warning: $1${NC}"
}

print_info() {
    printf '%b\n' "${BLUE}Info: $1${NC}"
}

print_debug() {
    if [ "$VERBOSE" -eq 1 ]; then
        printf '%b\n' "${BLUE}[DEBUG] $1${NC}" >&2
    fi
}

print_header() {
    printf '%b\n' "${BLUE}═══════════════════════════════════════${NC}"
    printf '%b\n' "${BLUE}$1${NC}"
    printf '%b\n' "${BLUE}═══════════════════════════════════════${NC}"
}

print_warnings_if_any() {
    if [ -n "${COMPILATION_WARNINGS:-}" ]; then
        printf '%b\n' "\n${YELLOW}Compilation Warnings:${NC}"
        printf '%s\n' "$COMPILATION_WARNINGS"
    fi
}

is_tty() {
    [ -t 0 ] && [ -t 1 ]
}

# Error handling with context
error_exit() {
    local msg="$1"
    local code="${2:-1}"
    print_error "$msg"
    exit "$code"
}

# Validate file exists
validate_file() {
    if [ ! -f "$1" ]; then
        error_exit "File not found: $1" "$EXIT_IO"
    fi
}

# Validate directory exists
validate_dir() {
    if [ ! -d "$1" ]; then
        error_exit "Directory not found: $1" "$EXIT_IO"
    fi
}

# Check if directory exists
dir_exists() {
    [ -d "$1" ]
}

# Milliseconds since the epoch (bash 5 EPOCHREALTIME, GNU date, or seconds).
now_ms() {
    if [ -n "${EPOCHREALTIME:-}" ]; then
        local s="${EPOCHREALTIME%.*}"
        local us="${EPOCHREALTIME#*.}"
        printf '%s' "$(( s * 1000 + 10#${us:0:3} ))"
    elif date +%s%N 2>/dev/null | grep -q '^[0-9]\{13,\}$'; then
        local ns
        ns=$(date +%s%N)
        printf '%s' "$(( ns / 1000000 ))"
    else
        printf '%s' "$(( $(date +%s) * 1000 ))"
    fi
}

# Validate the checker name
validate_checker() {
    case "$1" in
        lines|tokens) return 0 ;;
        *) error_exit "Unknown checker: $1 (use lines or tokens)" "$EXIT_USAGE" ;;
    esac
}

# Resolve a problem directory from an argument (or the cwd). Prints the
# absolute path, or nothing when no problem context can be found.
#   1. <arg> as a directory containing problem.txt
#   2. src/<arg>
#   3. the cwd, when it holds problem.txt
resolve_problem_dir() {
    local arg="${1:-}"
    if [ -n "$arg" ]; then
        if [ -d "$arg" ] && [ -f "$arg/problem.txt" ]; then
            (cd "$arg" && pwd)
            return 0
        elif [ -d "$SRC_DIR/$arg" ] && [ -f "$SRC_DIR/$arg/problem.txt" ]; then
            printf '%s' "$SRC_DIR/$arg"
            return 0
        fi
        return 1
    fi
    if [ -f "$PWD/problem.txt" ]; then
        printf '%s' "$PWD"
        return 0
    fi
    return 1
}

# Global flag to track if timeout warning has been shown
TIMEOUT_WARNING_SHOWN=0

# Check for timeout command availability
check_timeout_cmd() {
    if command -v timeout &> /dev/null; then
        TIMEOUT_CMD="timeout"
        return 0
    elif command -v gtimeout &> /dev/null; then
        TIMEOUT_CMD="gtimeout"
        return 0
    else
        if [ "$TIMEOUT_WARNING_SHOWN" -eq 0 ]; then
            print_warning "timeout command not found; execution timeout protection disabled"
            if command -v brew &> /dev/null; then
                print_info "Install on macOS: brew install coreutils"
            fi
            TIMEOUT_WARNING_SHOWN=1
        fi
        return 1
    fi
}

# Cleanup management (single trap)
CLEANUP_ITEMS=()
add_cleanup() {
    CLEANUP_ITEMS+=("$1")
}
run_cleanup() {
    local item
    for item in "${CLEANUP_ITEMS[@]}"; do
        rm -f "$item" 2>/dev/null || true
    done
}
trap 'run_cleanup' EXIT

# Hash sources for build cache
compute_sources_hash() {
    local sources=("$@")
    local hash_cmd=""
    if command -v sha256sum &> /dev/null; then
        hash_cmd="sha256sum"
    elif command -v shasum &> /dev/null; then
        hash_cmd="shasum -a 256"
    else
        return 1
    fi

    {
        printf '%s\n' "$COMPILER" "$CXXFLAGS"
        for s in "${sources[@]}"; do
            printf '%s\n' "$s"
            cat "$s"
        done
    } | eval "$hash_cmd" | awk '{print $1}'
}

# Safe execution with timeout and resource tracking. Sets LAST_RUN_MS.
LAST_RUN_MS=0
safe_execute() {
    local output_file=""
    if [[ "$1" == --output=* ]]; then
        output_file="${1#--output=}"
        shift
    fi
    local binary="$1"
    local input_file="${2:-}"
    local timeout_sec="${EXEC_TIMEOUT}"

    local time_log
    time_log=$(mktemp)
    add_cleanup "$time_log"

    local cmd=()
    if check_timeout_cmd; then
        cmd+=("$TIMEOUT_CMD" "$timeout_sec")
    fi
    cmd+=("$binary")

    local exit_code=0

    local use_time=0
    if [ -x "/usr/bin/time" ]; then
        # Check if /usr/bin/time supports the -f flag (GNU time)
        if /usr/bin/time -f "test" echo test &>/dev/null; then
            use_time=1
        fi
    fi

    local started
    started=$(now_ms)
    if [ "$use_time" -eq 1 ]; then
        if [ -n "$output_file" ]; then
            if [ -n "$input_file" ] && [ -f "$input_file" ]; then
                /usr/bin/time -f "RESOURCE_USAGE: %e %M" -o "$time_log" "${cmd[@]}" < "$input_file" > "$output_file" 2>&1
            else
                /usr/bin/time -f "RESOURCE_USAGE: %e %M" -o "$time_log" "${cmd[@]}" > "$output_file" 2>&1
            fi
        else
            if [ -n "$input_file" ] && [ -f "$input_file" ]; then
                /usr/bin/time -f "RESOURCE_USAGE: %e %M" -o "$time_log" "${cmd[@]}" < "$input_file" 2>&1
            else
                /usr/bin/time -f "RESOURCE_USAGE: %e %M" -o "$time_log" "${cmd[@]}" 2>&1
            fi
        fi
        exit_code=$?
        # Print resource usage to stdout for the web UI to capture
        cat "$time_log" 2>/dev/null || true
    else
        if [ -n "$output_file" ]; then
            if [ -n "$input_file" ] && [ -f "$input_file" ]; then
                "${cmd[@]}" < "$input_file" > "$output_file" 2>&1
            else
                "${cmd[@]}" > "$output_file" 2>&1
            fi
        else
            if [ -n "$input_file" ] && [ -f "$input_file" ]; then
                "${cmd[@]}" < "$input_file" 2>&1
            else
                "${cmd[@]}" 2>&1
            fi
        fi
        exit_code=$?
    fi
    LAST_RUN_MS=$(( $(now_ms) - started ))

    if [ $exit_code -eq 124 ]; then
        print_error "Execution timeout (exceeded ${timeout_sec}s)"
        return 1
    elif [ $exit_code -ne 0 ]; then
        # Codeforces requires exit code 0.
        print_error "Runtime error (exit code: $exit_code)"
        return 1
    fi
    return 0
}

# Compile with error reporting
safe_compile() {
    local output="$1"
    shift
    local sources=("$@")

    print_debug "Compiling: ${sources[*]} -> $output"

    # Clear previous warnings
    COMPILATION_WARNINGS=""

    local compile_out
    # shellcheck disable=SC2086  # CXXFLAGS is intentionally word-split
    compile_out=$($COMPILER $CXXFLAGS -I "$INCLUDE_DIR" "${sources[@]}" -o "$output" 2>&1)
    local ret=$?

    if [ $ret -ne 0 ]; then
        [ -n "$compile_out" ] && printf '%s\n' "$compile_out"
        print_error "Compilation failed"
        return $ret
    fi

    # Store warnings for later
    COMPILATION_WARNINGS="$compile_out"

    return 0
}

# Compile the given sources into the build cache (or a temp file when hashing
# is unavailable). Prints the binary path. Honors CF_FORCE_REBUILD=1.
compile_cached() {
    local label="$1"
    shift
    local sources=("$@")
    local output_file
    local sources_hash=""
    sources_hash=$(compute_sources_hash "${sources[@]}") || true
    if [ -n "$sources_hash" ]; then
        mkdir -p "$BUILD_CACHE_DIR" || error_exit "Failed to create build cache directory" "$EXIT_IO"
        output_file="$BUILD_CACHE_DIR/$sources_hash"
    else
        output_file=$(mktemp) || error_exit "Failed to create temp file" "$EXIT_IO"
        add_cleanup "$output_file"
    fi

    if [ -x "$output_file" ] && [ -n "$sources_hash" ] && [ "${CF_FORCE_REBUILD:-0}" -ne 1 ]; then
        print_info "$label: using cached build" >&2
    else
        print_info "$label: compiling with $COMPILER..." >&2
        if ! safe_compile "$output_file" "${sources[@]}"; then
            rm -f "$output_file" 2>/dev/null || true
            return 1
        fi
        chmod +x "$output_file" 2>/dev/null || true
    fi
    printf '%s' "$output_file"
}

# Extract example block (input or output) from problem description file
extract_example_block() {
    local file="$1"
    local sample_index="${2:-1}"
    local target="$3"

    if [ ! -f "$file" ]; then
        return 1
    fi

    # Check if this looks like a problem description with Examples section
    if grep -qi "Examples\|Example" "$file" 2>/dev/null; then
        awk -v idx="$sample_index" -v target="$target" '
            function norm(s){ gsub(/\r/, "", s); return s }
            function trim(s){ sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s); return s }
            function norm_head(s){ s=tolower(s); gsub(/[[:space:]]+/, " ", s); s=trim(s); return s }
            function is_head(s, name){ s=norm_head(s); name=tolower(name); return (s==name || s==name":" || s==name" :") }
            function is_input_head(s){ return is_head(s, "input") || is_head(s, "sample input") || is_head(s, "inputcopy") }
            function is_output_head(s){ return is_head(s, "output") || is_head(s, "sample output") || is_head(s, "outputcopy") }
            function is_stop_head(s){ return is_head(s, "note") || is_head(s, "explanation") || is_head(s, "constraints") || is_head(s, "examples") }
            BEGIN { in_examples=0; in_block=0; printed=0; example_idx=0 }
            {
                line=norm($0)
                if (!in_examples && line ~ /^[[:space:]]*$/) next
                if (!in_examples && tolower(line) ~ /^examples?:?$/) { in_examples=1; next }
                if (!in_examples && tolower(line) ~ /^example[[:space:]]*[0-9]*$/) { in_examples=1; next }
                if (!in_examples) next

                if (is_input_head(line)) {
                    example_idx++
                    if (target=="input") {
                        in_block=(example_idx==idx)
                    } else {
                        if (in_block && example_idx > idx) exit
                        in_block=0
                    }
                    next
                }
                if (is_output_head(line)) {
                    if (target=="output") {
                        in_block=(example_idx==idx)
                    } else if (in_block) {
                        exit
                    }
                    next
                }
                if (target=="output" && is_stop_head(line)) { if (in_block) exit }

                if (in_block) {
                    if (tolower(trim(line))=="copy") next
                    print line
                    printed=1
                }
            }
            END { if (!printed) exit 1 }
        ' "$file"
    else
        return 1
    fi
}

# Extract test input from problem description file
extract_test_input() {
    local file="$1"
    local sample_index="${2:-1}"

    if [ ! -f "$file" ]; then
        print_debug "Problem file not found: $file"
        return 1
    fi

    if grep -qi "Examples\|Example" "$file" 2>/dev/null; then
        extract_example_block "$file" "$sample_index" "input"
    else
        # Regular input file, return as-is
        cat "$file"
    fi
}

# Extract expected output from problem description file
extract_expected_output() {
    local file="$1"
    local sample_index="${2:-1}"

    if [ ! -f "$file" ]; then
        return 1
    fi

    if grep -qi "Examples\|Example" "$file" 2>/dev/null; then
        extract_example_block "$file" "$sample_index" "output"
    else
        return 1
    fi
}

# Count sample inputs in a problem statement
count_samples() {
    local file="$1"

    if [ ! -f "$file" ]; then
        return 0
    fi

    if ! grep -qi "Examples\|Example" "$file" 2>/dev/null; then
        printf '0'
        return 0
    fi

    awk '
        function norm(s){ gsub(/\r/, "", s); return s }
        function trim(s){ sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s); return s }
        function norm_head(s){ s=tolower(s); gsub(/[[:space:]]+/, " ", s); s=trim(s); return s }
        function is_head(s, name){ s=norm_head(s); name=tolower(name); return (s==name || s==name":" || s==name" :") }
        BEGIN { in_examples=0; count=0 }
        {
            line=norm($0)
            if (!in_examples && line ~ /^[[:space:]]*$/) next
            if (!in_examples && tolower(line) ~ /^examples?:?$/) { in_examples=1; next }
            if (!in_examples && tolower(line) ~ /^example[[:space:]]*[0-9]*$/) { in_examples=1; next }
            if (!in_examples) next

            if (is_head(line, "input") || is_head(line, "sample input") || is_head(line, "inputcopy")) { count++ }
        }
        END { print count }
    ' "$file"
}

# Normalize output for comparison according to $CHECKER.
#   lines:  strip \r, trim blank edges, trim trailing spaces per line
#   tokens: one whitespace-separated token per line
normalize_output() {
    if [ "$CHECKER" = "tokens" ]; then
        printf '%s' "$1" | tr -d '\r' | tr -s '[:space:]' '\n' | sed '/^$/d'
        return 0
    fi
    printf '%s' "$1" | tr -d '\r' | awk '
        { sub(/[[:space:]]+$/, "", $0); lines[NR]=$0 }
        END {
            start=1; end=NR
            while (start<=NR && lines[start] ~ /^[[:space:]]*$/) start++
            while (end>=start && lines[end] ~ /^[[:space:]]*$/) end--
            for (i=start; i<=end; i++) {
                if (i>start) printf "\n"
                printf "%s", lines[i]
            }
        }
    '
}

# Compare two output strings under the active checker. Returns 0 on match.
outputs_match() {
    local expected="$1"
    local actual="$2"
    local a b
    a=$(mktemp)
    b=$(mktemp)
    add_cleanup "$a"
    add_cleanup "$b"
    normalize_output "$expected" > "$a"
    normalize_output "$actual" > "$b"
    cmp -s "$a" "$b"
}

# Collect the .cpp files of a problem directory into the cpp_files array.
collect_cpp_files() {
    local dir="$1"
    cpp_files=()
    while IFS= read -r file; do
        [ -n "$file" ] && cpp_files+=("$file")
    done < <(find "$dir" -maxdepth 1 -name "*.cpp" -type f 2>/dev/null | sort)
}

# ==================== TEMPLATE COMMAND ====================

cmd_template() {
    local problem_name=""
    local from=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --from|-f)
                shift || true
                [ -z "${1:-}" ] && error_exit "Missing value for --from" "$EXIT_USAGE"
                from="$1"
                ;;
            --help|-h)
                cmd_help
                return 0
                ;;
            *)
                if [ -z "$problem_name" ]; then
                    problem_name="$1"
                else
                    print_warning "Ignoring extra argument: $1"
                fi
                ;;
        esac
        shift || true
    done

    if [ -z "$problem_name" ]; then
        print_error "Usage: cf template <name> [--from dp|graph|math]"
        printf '%s\n' "Example: cf template 1000A"
        return 1
    fi

    # Validate problem name format
    if ! [[ "$problem_name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        print_error "Invalid problem name: $problem_name (use alphanumeric, dash, or underscore)"
        return 1
    fi

    # Pick the template source
    local template_src="$SRC_DIR/template.cpp"
    if [ -n "$from" ]; then
        if [ -f "$from" ]; then
            template_src="$from"
        elif [ -f "$TEMPLATES_DIR/$from.cpp" ]; then
            template_src="$TEMPLATES_DIR/$from.cpp"
        else
            local available
            available=$(find "$TEMPLATES_DIR" -maxdepth 1 -name '*.cpp' -exec basename {} .cpp \; 2>/dev/null | sort | tr '\n' ' ')
            error_exit "Template not found: $from (available: ${available:-none})" "$EXIT_IO"
        fi
    fi

    # Create problem directory in current working directory
    local problem_dir="$PWD/$problem_name"

    if dir_exists "$problem_dir"; then
        print_info "Problem directory already exists: $problem_dir"
    else
        mkdir -p "$problem_dir" || error_exit "Failed to create directory: $problem_dir" "$EXIT_IO"
        print_success "Created directory: $problem_dir"
    fi

    # Copy template to solution.cpp
    local solution_file="$problem_dir/solution.cpp"

    if [ -f "$solution_file" ]; then
        print_info "Solution already exists: $solution_file"
    else
        if [ -f "$template_src" ]; then
            cp "$template_src" "$solution_file" || error_exit "Failed to copy template" "$EXIT_IO"
            print_success "Created solution: $solution_file (from $(basename "$template_src"))"
        else
            error_exit "Template file not found: $template_src" "$EXIT_IO"
        fi
    fi

    # Create problem.txt file
    local problem_file="$problem_dir/problem.txt"

    if [ -f "$problem_file" ]; then
        print_info "Problem file already exists: $problem_file"
    else
        cat > "$problem_file" << 'EOF' || error_exit "Failed to create problem file" "$EXIT_IO"
# Paste the problem statement here from Codeforces

Examples
Input


Output


EOF
        print_success "Created problem file: $problem_file"
    fi

    # Compile to verify setup
    print_info "Verifying compilation..."
    local output_file
    output_file=$(mktemp) || error_exit "Failed to create temp file" "$EXIT_IO"
    add_cleanup "$output_file"

    if safe_compile "$output_file" "$solution_file"; then
        print_success "Compilation verified"
    else
        error_exit "Compilation failed. Check your C++ compiler." "$EXIT_COMPILE"
    fi

    # Open files in VS Code if available
    if [ "${CF_SERVE_MODE:-0}" -eq 0 ] && [ "${CF_NO_EDITOR:-0}" -eq 0 ] && command -v code &> /dev/null; then
        print_info "Opening files in VS Code..."
        code "$problem_file" "$solution_file" 2>/dev/null || true
        print_success "Opened in VS Code"
    fi

    if [ "${CF_SERVE_MODE:-0}" -eq 0 ]; then
        printf '\n'
        printf '%s\n' "Next steps:"
        printf '%s\n' "  1. Paste problem statement in $problem_file"
        printf '%s\n' "  2. Edit solution in $solution_file"
        printf '%s\n' "  3. cd $problem_name && cf test"
    fi
}

# ==================== RUN COMMAND ====================

cmd_run() {
    local input_arg=""
    local inline_arg=""
    local sample_index="1"
    local use_stdin=0
    local sample_set=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --sample|-s)
                shift || true
                if [ -z "${1:-}" ]; then
                    error_exit "Missing value for --sample" "$EXIT_USAGE"
                fi
                sample_index="$1"
                sample_set=1
                ;;
            --input|--file|-i)
                shift || true
                if [ -z "${1:-}" ]; then
                    error_exit "Missing value for --input" "$EXIT_USAGE"
                fi
                input_arg="$1"
                ;;
            --checker|-c)
                shift || true
                [ -z "${1:-}" ] && error_exit "Missing value for --checker" "$EXIT_USAGE"
                CHECKER="$1"
                validate_checker "$CHECKER"
                ;;
            --timeout|-t)
                shift || true
                [ -z "${1:-}" ] && error_exit "Missing value for --timeout" "$EXIT_USAGE"
                EXEC_TIMEOUT="$1"
                ;;
            --stdin)
                use_stdin=1
                ;;
            --help|-h)
                cmd_help
                return 0
                ;;
            *)
                if [ -z "$input_arg" ]; then
                    input_arg="$1"
                elif [[ "$1" =~ ^[0-9]+$ ]] && [ "$sample_set" -eq 0 ] && [ -f "$input_arg" ]; then
                    sample_index="$1"
                elif [ -z "$inline_arg" ]; then
                    # `cf <problem> "<input>"` — second positional is inline stdin
                    inline_arg="$1"
                else
                    print_warning "Ignoring extra argument: $1"
                fi
                ;;
        esac
        shift || true
    done

    if ! [[ "$sample_index" =~ ^[0-9]+$ ]] || [ "$sample_index" -lt 1 ]; then
        error_exit "Invalid sample index: $sample_index" "$EXIT_USAGE"
    fi

    # Handle directory as input_arg — and remember the problem dir so the
    # compile step happens THERE, not in whatever cwd cf was launched from
    # (this is what makes `cf <problem>` work from the repo root).
    local prob_dir=""
    if [ -n "$input_arg" ] && [ ! -f "$input_arg" ]; then
        if prob_dir=$(resolve_problem_dir "$input_arg"); then
            input_arg="$prob_dir/problem.txt"
        elif [ "$(basename "$PWD")" = "$input_arg" ] && [ -f "$PWD/problem.txt" ]; then
            input_arg="$PWD/problem.txt"
        else
            prob_dir=""
        fi
    fi

    if [ "$use_stdin" -eq 0 ] && [ -z "$input_arg" ] && [ -f "$PWD/problem.txt" ]; then
        input_arg="$PWD/problem.txt"
    fi

    # Find .cpp files in the problem dir (when named) or current directory.
    local src_ctx="${prob_dir:-$PWD}"
    collect_cpp_files "$src_ctx"
    if [ ${#cpp_files[@]} -eq 0 ]; then
        error_exit "No C++ file found in $src_ctx" "$EXIT_USAGE"
    fi

    print_info "Using: ${#cpp_files[@]} source file(s)"

    # Compile (build cache)
    local output_file
    output_file=$(compile_cached "solution" "${cpp_files[@]}") || return 1
    print_success "Compiled successfully"

    # Prepare input
    local input_data=""
    local expected_output=""
    local is_problem_file=false
    local temp_input=""
    local compare_enabled=false

    if [ "$use_stdin" -eq 1 ]; then
        print_info "Running with stdin (forced)"
    elif [ -n "$inline_arg" ]; then
        # `cf <problem> "<input>"` — literal stdin beats sample extraction.
        print_info "Running with inline input"
        input_data=$(printf "%b" "$inline_arg") || true
        temp_input=$(mktemp) || error_exit "Failed to create temp input file" "$EXIT_IO"
        printf '%s' "$input_data" > "$temp_input"
        add_cleanup "$temp_input"
    elif [ -n "$input_arg" ]; then
        if [ -f "$input_arg" ]; then
            # Input is a file - extract test input intelligently
            print_info "Running with input from: $input_arg"

            # Check if this is a problem file and extract expected output
            if grep -qi "Examples\|Example" "$input_arg" 2>/dev/null; then
                is_problem_file=true
                local sample_count
                sample_count=$(count_samples "$input_arg")
                if [ "$sample_count" -gt 0 ] && [ "$sample_index" -gt "$sample_count" ]; then
                    print_warning "Requested sample #$sample_index, but only $sample_count found; using sample #1"
                    sample_index=1
                fi
                expected_output=$(extract_expected_output "$input_arg" "$sample_index") || true
            fi

            # Create temp input file and write extracted input directly
            temp_input=$(mktemp) || error_exit "Failed to create temp input file" "$EXIT_IO"
            if ! extract_test_input "$input_arg" "$sample_index" > "$temp_input"; then
                print_warning "No sample input found in examples; falling back to samples/ or stdin"
                rm -f "$temp_input" 2>/dev/null || true
                temp_input=""
            fi

            if [ -z "$temp_input" ] && [ -d "$src_ctx/samples" ]; then
                local sample_in="$src_ctx/samples/${sample_index}.in"
                local sample_out="$src_ctx/samples/${sample_index}.out"
                if [ -f "$sample_in" ]; then
                    temp_input=$(mktemp) || error_exit "Failed to create temp input file" "$EXIT_IO"
                    cat "$sample_in" > "$temp_input"
                    if [ -f "$sample_out" ]; then
                        expected_output=$(cat "$sample_out")
                        is_problem_file=true
                    fi
                fi
            fi

            if [ -n "$temp_input" ]; then
                add_cleanup "$temp_input"
            else
                print_warning "No sample input found; falling back to interactive stdin"
            fi
        else
            # Input is a string (possibly with escaped newlines)
            print_info "Running with inline input"
            # Interpret escape sequences
            input_data=$(printf "%b" "$input_arg") || true

            # Create temp input file
            temp_input=$(mktemp) || error_exit "Failed to create temp input file" "$EXIT_IO"
            printf '%s' "$input_data" > "$temp_input"
            add_cleanup "$temp_input"
        fi
    else
        print_info "Running with stdin (pipe input or interactive)"
    fi

    # Execute with input
    printf '\n'
    if [ -n "$temp_input" ]; then
        print_info "Input Used:"
        printf -- '---\n'
        cat "$temp_input"
        printf -- '\n---\n'
    fi
    print_info "Your Output:"
    printf -- '---\n'

    local tmp_actual_output=""
    if [ -n "$temp_input" ]; then
        tmp_actual_output=$(mktemp)
        add_cleanup "$tmp_actual_output"
        if ! safe_execute --output="$tmp_actual_output" "$output_file" "$temp_input"; then
            cat "$tmp_actual_output" 2>/dev/null || true
            print_warnings_if_any
            return 1
        fi
        # Stream output directly to stdout, not through variable
        cat "$tmp_actual_output"
        compare_enabled=true
    else
        if ! safe_execute "$output_file"; then
            print_warnings_if_any
            return 1
        fi
    fi

    printf -- '\n---\n'
    printf '%b\n' "${DIM}Elapsed: ${LAST_RUN_MS} ms${NC}"

    # Display expected output if available
    if [ "$is_problem_file" = true ] && [ "$compare_enabled" = true ]; then
        if [ -n "$expected_output" ]; then
            printf '\n'
            print_info "Expected Output:"
            printf -- '---\n'
            printf '%s' "$expected_output"
            printf -- '\n---\n'

            if outputs_match "$expected_output" "$(cat "$tmp_actual_output")"; then
                print_success "Output matches expected."
            else
                print_warning "Output does not match expected."
                if [ "$CHECKER" = "lines" ]; then
                    local saved_checker="$CHECKER"
                    CHECKER="tokens"
                    if outputs_match "$expected_output" "$(cat "$tmp_actual_output")"; then
                        print_info "Tokens match; only whitespace differs (try --checker tokens)."
                    fi
                    CHECKER="$saved_checker"
                fi
                print_warnings_if_any
                return 1
            fi
        else
            print_warning "No sample output detected; skipping compare"
        fi
    elif [ "$is_problem_file" = true ] && [ "$compare_enabled" = false ]; then
        print_warning "Expected output available but input was interactive; skipping compare"
    fi

    print_warnings_if_any
    print_success "Execution complete"
}

# ==================== TEST COMMAND ====================

cmd_test_all() {
    local prob_dir="$1"
    local prob_file="$prob_dir/problem.txt"

    validate_dir "$prob_dir"
    validate_file "$prob_file"

    # Find .cpp files (brute/generator sources are not part of the solution)
    collect_cpp_files "$prob_dir"
    local sources=()
    local f
    for f in "${cpp_files[@]}"; do
        case "$(basename "$f")" in
            brute.cpp|gen.cpp|generator.cpp) ;;
            *) sources+=("$f") ;;
        esac
    done
    if [ ${#sources[@]} -eq 0 ]; then
        error_exit "No C++ file found in $prob_dir" "$EXIT_USAGE"
    fi

    print_info "Testing problem in: $prob_dir"
    print_info "Found ${#sources[@]} source file(s), checker: $CHECKER"

    # Compile
    local output_binary
    output_binary=$(compile_cached "solution" "${sources[@]}") || return 1

    local sample_count
    sample_count=$(count_samples "$prob_file")

    if [ "$sample_count" -eq 0 ]; then
        print_warning "No samples found in $prob_file"
        return 0
    fi

    print_info "Found $sample_count samples. Starting tests..."

    local passed=0
    local failed=0
    local max_ms=0

    for ((i=1; i<=sample_count; i++)); do
        printf '\n'
        print_info "Running Sample #$i..."

        local temp_input
        local temp_actual
        temp_input=$(mktemp)
        temp_actual=$(mktemp)
        add_cleanup "$temp_input"
        add_cleanup "$temp_actual"

        if ! extract_test_input "$prob_file" "$i" > "$temp_input"; then
            print_warning "Failed to extract input for sample #$i"
            continue
        fi

        local expected_data
        expected_data=$(extract_expected_output "$prob_file" "$i") || true

        if ! safe_execute --output="$temp_actual" "$output_binary" "$temp_input"; then
            print_error "Sample #$i: Runtime Error or Timeout (${LAST_RUN_MS} ms)"
            sed 's/^/  /' "$temp_actual" | head -20
            failed=$((failed + 1))
            continue
        fi
        [ "$LAST_RUN_MS" -gt "$max_ms" ] && max_ms="$LAST_RUN_MS"

        if outputs_match "$expected_data" "$(cat "$temp_actual")"; then
            print_success "Sample #$i: PASSED (${LAST_RUN_MS} ms)"
            passed=$((passed + 1))
        else
            print_error "Sample #$i: FAILED (Output Mismatch, ${LAST_RUN_MS} ms)"
            printf '%b\n' "${YELLOW}Input Used:${NC}"
            sed 's/^/  /' "$temp_input"
            printf '%b\n' "${YELLOW}Expected Output:${NC}"
            printf '%s\n' "$expected_data" | sed 's/^/  /'
            printf '%b\n' "${YELLOW}Your Output:${NC}"
            sed 's/^/  /' "$temp_actual"

            # Show diff if possible
            if command -v diff &> /dev/null; then
                local norm_actual norm_expected
                norm_actual=$(mktemp)
                norm_expected=$(mktemp)
                add_cleanup "$norm_actual"
                add_cleanup "$norm_expected"
                normalize_output "$(cat "$temp_actual")" > "$norm_actual"
                normalize_output "$expected_data" > "$norm_expected"
                printf '%b\n' "${YELLOW}Diff:${NC}"
                diff -u "$norm_expected" "$norm_actual" | sed 's/^/  /' || true
            fi
            failed=$((failed + 1))
        fi
    done

    printf '\n'
    print_header "Test Summary"
    print_info "Total: $sample_count | Passed: ${GREEN}$passed${NC} | Failed: ${RED}$failed${NC} | Max time: ${max_ms} ms"

    if [ "$failed" -eq 0 ]; then
        print_warnings_if_any
        print_success "All problem samples passed!"
        return 0
    else
        print_warnings_if_any
        return 1
    fi
}

cmd_test() {
    local arg=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --checker|-c)
                shift || true
                [ -z "${1:-}" ] && error_exit "Missing value for --checker" "$EXIT_USAGE"
                CHECKER="$1"
                validate_checker "$CHECKER"
                ;;
            --timeout|-t)
                shift || true
                [ -z "${1:-}" ] && error_exit "Missing value for --timeout" "$EXIT_USAGE"
                EXEC_TIMEOUT="$1"
                ;;
            --help|-h)
                cmd_help
                return 0
                ;;
            *)
                if [ -z "$arg" ]; then
                    arg="$1"
                else
                    print_warning "Ignoring extra argument: $1"
                fi
                ;;
        esac
        shift || true
    done

    # An explicit problem argument wins; otherwise fall back to the cwd.
    local prob_dir=""
    if [ -n "$arg" ]; then
        prob_dir=$(resolve_problem_dir "$arg") || error_exit "Problem not found: $arg (looked in ./$arg and $SRC_DIR/$arg)" "$EXIT_IO"
    else
        prob_dir=$(resolve_problem_dir) || true
    fi

    if [ -n "$prob_dir" ]; then
        cmd_test_all "$prob_dir"
        return $?
    fi

    # Fallback to toolkit internal tests
    print_info "No problem context found. Running toolkit test suite..."

    if [ ! -f "$SCRIPTS_DIR/test.sh" ]; then
        print_warning "Test script not found: $SCRIPTS_DIR/test.sh"
        print_info "Using fallback: testing template.cpp"

        if [ ! -f "$SRC_DIR/template.cpp" ]; then
            error_exit "Template file not found" "$EXIT_IO"
        fi

        # Basic test
        local output_file
        output_file=$(mktemp) || error_exit "Failed to create temp file" "$EXIT_IO"
        add_cleanup "$output_file"

        if safe_compile "$output_file" "$SRC_DIR/template.cpp"; then
            print_success "Template compiles successfully"
        else
            return 1
        fi
    else
        bash "$SCRIPTS_DIR/test.sh"
    fi
}

# ==================== SAMPLES COMMAND ====================

cmd_samples() {
    local arg="${1:-}"
    local prob_dir
    prob_dir=$(resolve_problem_dir "$arg") || error_exit "No problem.txt found${arg:+ for $arg}" "$EXIT_IO"
    local prob_file="$prob_dir/problem.txt"
    local n
    n=$(count_samples "$prob_file")
    print_info "$prob_file: $n sample(s)"
    local i
    for ((i=1; i<=n; i++)); do
        printf '\n%b\n' "${BLUE}Sample #$i input:${NC}"
        normalize_output "$(extract_test_input "$prob_file" "$i")" | sed 's/^/  /'
        printf '\n%b\n' "${BLUE}Sample #$i output:${NC}"
        normalize_output "$(extract_expected_output "$prob_file" "$i" || printf '(none)')" | sed 's/^/  /'
        printf '\n'
    done
}

# ==================== STRESS COMMAND ====================

cmd_stress() {
    local arg=""
    local iterations="${CF_STRESS_ITERATIONS:-200}"
    local brute_src=""
    local gen_src=""
    local seed_base=1

    while [ $# -gt 0 ]; do
        case "$1" in
            -n|--iterations)
                shift || true
                [[ "${1:-}" =~ ^[0-9]+$ ]] || error_exit "Invalid iteration count: ${1:-}" "$EXIT_USAGE"
                iterations="$1"
                ;;
            --brute|-b)
                shift || true
                [ -z "${1:-}" ] && error_exit "Missing value for --brute" "$EXIT_USAGE"
                brute_src="$1"
                ;;
            --gen|--generator|-g)
                shift || true
                [ -z "${1:-}" ] && error_exit "Missing value for --gen" "$EXIT_USAGE"
                gen_src="$1"
                ;;
            --seed)
                shift || true
                [[ "${1:-}" =~ ^[0-9]+$ ]] || error_exit "Invalid seed: ${1:-}" "$EXIT_USAGE"
                seed_base="$1"
                ;;
            --checker|-c)
                shift || true
                [ -z "${1:-}" ] && error_exit "Missing value for --checker" "$EXIT_USAGE"
                CHECKER="$1"
                validate_checker "$CHECKER"
                ;;
            --timeout|-t)
                shift || true
                [ -z "${1:-}" ] && error_exit "Missing value for --timeout" "$EXIT_USAGE"
                EXEC_TIMEOUT="$1"
                ;;
            --help|-h)
                cmd_help
                return 0
                ;;
            *)
                if [ -z "$arg" ]; then
                    arg="$1"
                else
                    print_warning "Ignoring extra argument: $1"
                fi
                ;;
        esac
        shift || true
    done

    local prob_dir
    if [ -n "$arg" ]; then
        prob_dir=$(resolve_problem_dir "$arg") || {
            if [ -d "$arg" ]; then prob_dir="$(cd "$arg" && pwd)"; else error_exit "Problem not found: $arg" "$EXIT_IO"; fi
        }
    else
        prob_dir="$PWD"
    fi

    [ -z "$brute_src" ] && brute_src="$prob_dir/brute.cpp"
    if [ -z "$gen_src" ]; then
        if [ -f "$prob_dir/gen.cpp" ]; then gen_src="$prob_dir/gen.cpp"; else gen_src="$prob_dir/generator.cpp"; fi
    fi
    validate_file "$brute_src"
    validate_file "$gen_src"

    collect_cpp_files "$prob_dir"
    local sources=()
    local f
    for f in "${cpp_files[@]}"; do
        case "$(basename "$f")" in
            brute.cpp|gen.cpp|generator.cpp) ;;
            *) sources+=("$f") ;;
        esac
    done
    [ ${#sources[@]} -eq 0 ] && error_exit "No solution source found in $prob_dir" "$EXIT_USAGE"

    print_header "Stress test: ${iterations} iterations, checker $CHECKER"
    local sol_bin brute_bin gen_bin
    sol_bin=$(compile_cached "solution" "${sources[@]}") || return 1
    brute_bin=$(compile_cached "brute" "$brute_src") || return 1
    gen_bin=$(compile_cached "generator" "$gen_src") || return 1

    local input_tmp sol_out brute_out
    input_tmp=$(mktemp); sol_out=$(mktemp); brute_out=$(mktemp)
    add_cleanup "$input_tmp"; add_cleanup "$sol_out"; add_cleanup "$brute_out"

    local i seed started max_ms=0
    started=$(now_ms)
    for ((i=0; i<iterations; i++)); do
        seed=$((seed_base + i))
        if ! "$gen_bin" "$seed" > "$input_tmp" 2>/dev/null; then
            print_error "Generator failed on seed $seed"
            return 1
        fi
        if ! safe_execute --output="$sol_out" "$sol_bin" "$input_tmp" > /dev/null; then
            print_error "Solution crashed or timed out on iteration $((i+1)) (seed $seed)"
            cp "$input_tmp" "$prob_dir/stress_fail.txt"
            print_info "Failing input saved to $prob_dir/stress_fail.txt"
            return 1
        fi
        [ "$LAST_RUN_MS" -gt "$max_ms" ] && max_ms="$LAST_RUN_MS"
        if ! safe_execute --output="$brute_out" "$brute_bin" "$input_tmp" > /dev/null; then
            print_error "Brute force crashed or timed out on iteration $((i+1)) (seed $seed)"
            cp "$input_tmp" "$prob_dir/stress_fail.txt"
            return 1
        fi
        if ! outputs_match "$(cat "$brute_out")" "$(cat "$sol_out")"; then
            printf '\n'
            print_error "Counter-example found on iteration $((i+1)) (seed $seed)"
            printf '%b\n' "${YELLOW}Input:${NC}"
            sed 's/^/  /' "$input_tmp"
            printf '%b\n' "${YELLOW}Brute output:${NC}"
            sed 's/^/  /' "$brute_out"
            printf '%b\n' "${YELLOW}Solution output:${NC}"
            sed 's/^/  /' "$sol_out"
            cp "$input_tmp" "$prob_dir/stress_fail.txt"
            print_info "Failing input saved to $prob_dir/stress_fail.txt"
            return 1
        fi
        if is_tty && (( (i+1) % 25 == 0 )); then
            printf '\r%b' "${DIM}  $((i+1))/$iterations ok, max ${max_ms} ms${NC}"
        fi
    done
    is_tty && printf '\r'
    print_success "No counter-example in $iterations iterations ($(( $(now_ms) - started )) ms, solution max ${max_ms} ms)"
}

# ==================== WATCH COMMAND ====================

# Signature of the watched files: mtimes of every .cpp and problem.txt.
watch_signature() {
    local dir="$1"
    find "$dir" -maxdepth 1 \( -name '*.cpp' -o -name 'problem.txt' \) -type f -exec ls -l --time-style=+%s {} + 2>/dev/null \
        || find "$dir" -maxdepth 1 \( -name '*.cpp' -o -name 'problem.txt' \) -type f -exec stat -f '%m %N' {} + 2>/dev/null
}

cmd_watch() {
    local arg="${1:-}"
    local prob_dir
    prob_dir=$(resolve_problem_dir "$arg") || error_exit "No problem.txt found${arg:+ for $arg}" "$EXIT_IO"
    print_info "Watching $prob_dir (Ctrl+C to stop)"
    local last=""
    while true; do
        local sig
        sig=$(watch_signature "$prob_dir")
        if [ "$sig" != "$last" ]; then
            last="$sig"
            if is_tty; then printf '\033[2J\033[H'; fi
            printf '%b\n' "${DIM}$(date '+%H:%M:%S') change detected${NC}"
            cmd_test_all "$prob_dir" || true
            printf '\n%b\n' "${DIM}Waiting for changes...${NC}"
        fi
        sleep 1
    done
}

# ==================== DOCTOR COMMAND ====================

doctor_check() {
    local status="$1"
    local label="$2"
    local detail="${3:-}"
    if [ "$status" = ok ]; then
        printf '%b\n' "  ${GREEN}ok${NC}    $label${detail:+ ${DIM}($detail)${NC}}"
    elif [ "$status" = warn ]; then
        printf '%b\n' "  ${YELLOW}warn${NC}  $label${detail:+ ${DIM}($detail)${NC}}"
    else
        printf '%b\n' "  ${RED}fail${NC}  $label${detail:+ ${DIM}($detail)${NC}}"
    fi
}

cmd_doctor() {
    local problems=0
    print_header "cf doctor (v$CF_VERSION)"
    printf '%b\n' "  repo  $REPO_ROOT"

    local cxx_ver
    cxx_ver=$($COMPILER --version 2>/dev/null | head -1)
    doctor_check ok "compiler: $COMPILER" "$cxx_ver"

    if [ -f "$INCLUDE_DIR/bits/stdc++.h" ]; then
        doctor_check ok "bits/stdc++.h shim" "$INCLUDE_DIR"
    else
        doctor_check fail "bits/stdc++.h shim missing" "$INCLUDE_DIR"
        problems=$((problems + 1))
    fi

    local tmp_src tmp_bin
    tmp_src=$(mktemp).cpp
    tmp_bin=$(mktemp)
    add_cleanup "$tmp_src"; add_cleanup "$tmp_bin"
    printf '%s\n' '#include <bits/stdc++.h>' 'int main(){int a,b;std::cin>>a>>b;std::cout<<a+b<<"\n";}' > "$tmp_src"
    local started
    started=$(now_ms)
    if safe_compile "$tmp_bin" "$tmp_src" > /dev/null 2>&1; then
        local out
        out=$(printf '2 3\n' | "$tmp_bin" 2>/dev/null || true)
        if [ "$out" = "5" ]; then
            doctor_check ok "compile + run smoke test" "$(( $(now_ms) - started )) ms with $CXXFLAGS"
        else
            doctor_check fail "smoke test produced '$out' instead of 5"
            problems=$((problems + 1))
        fi
    else
        doctor_check fail "smoke test failed to compile" "flags: $CXXFLAGS"
        problems=$((problems + 1))
    fi

    if command -v timeout &> /dev/null || command -v gtimeout &> /dev/null; then
        doctor_check ok "timeout command" "execution limit ${EXEC_TIMEOUT}s"
    else
        doctor_check warn "timeout command missing" "brew install coreutils"
    fi

    local tool
    for tool in node npm make shellcheck; do
        if command -v "$tool" &> /dev/null; then
            doctor_check ok "$tool" "$("$tool" --version 2>/dev/null | head -1)"
        elif [ "$tool" = node ] || [ "$tool" = npm ]; then
            doctor_check warn "$tool missing" "needed for cf serve"
        else
            doctor_check warn "$tool missing" "optional"
        fi
    done

    if [ -d "$REPO_ROOT/web/node_modules" ]; then
        doctor_check ok "web dependencies installed"
    else
        doctor_check warn "web dependencies not installed" "cf serve runs npm install"
    fi

    if [ -d "$BUILD_CACHE_DIR" ]; then
        local n
        n=$(find "$BUILD_CACHE_DIR" -maxdepth 1 -type f 2>/dev/null | wc -l | tr -d ' ')
        doctor_check ok "build cache" "$n binaries in $BUILD_CACHE_DIR"
    fi

    printf '\n'
    if [ "$problems" -eq 0 ]; then
        print_success "Everything looks good"
    else
        error_exit "$problems problem(s) found" 1
    fi
}

# ==================== CLEAN COMMAND ====================

cmd_clean() {
    local n=0
    if [ -d "$BUILD_CACHE_DIR" ]; then
        n=$(find "$BUILD_CACHE_DIR" -maxdepth 1 -type f 2>/dev/null | wc -l | tr -d ' ')
        rm -rf "$BUILD_CACHE_DIR"
    fi
    rm -rf "$BUILD_DIR"
    print_success "Removed build cache ($n cached binaries)"
}

# ==================== UPDATE COMMAND ====================

cmd_update() {
    print_info "Updating cf tool to latest version..."

    # Verify we're in a git repository
    if [ ! -d "$REPO_ROOT/.git" ]; then
        error_exit "Not a git repository: $REPO_ROOT" "$EXIT_UPDATE"
    fi

    # Save current directory
    local original_dir="$PWD"

    # Change to repository root
    cd "$REPO_ROOT" || error_exit "Failed to change to repository directory" 1

    # Check for uncommitted changes
    if ! git diff-index --quiet HEAD -- 2>/dev/null; then
        print_warning "You have uncommitted changes in the repository"
        if [ "${CF_NONINTERACTIVE:-0}" -eq 1 ] || ! is_tty; then
            error_exit "Update aborted in non-interactive mode due to uncommitted changes" "$EXIT_UPDATE"
        fi
        printf '%s' "Continue with update? (y/N): "
        read -r response
        if [[ ! "$response" =~ ^[Yy]$ ]]; then
            print_info "Update cancelled"
            cd "$original_dir" || true
            return 0
        fi
    fi

    # Determine upstream
    local current_branch
    local upstream
    local remote
    local remote_branch
    current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
    if [ -z "$upstream" ] && [ -n "$current_branch" ]; then
        upstream="origin/$current_branch"
    fi
    if [ -z "$upstream" ]; then
        error_exit "Unable to determine upstream branch" "$EXIT_UPDATE"
    fi
    remote="${upstream%%/*}"
    remote_branch="${upstream#*/}"

    # Fetch and pull latest changes
    print_info "Fetching latest changes from $remote..."
    if ! git fetch "$remote" 2>&1; then
        error_exit "Failed to fetch from remote repository" "$EXIT_UPDATE"
    fi

    print_info "Pulling latest changes from $remote/$remote_branch..."
    if ! git pull --ff-only "$remote" "$remote_branch" 2>&1; then
        error_exit "Failed to pull latest changes (non fast-forward?)" "$EXIT_UPDATE"
    fi

    print_success "Repository updated successfully"

    # Run setup script if it exists
    if [ -f "$SCRIPTS_DIR/setup.sh" ] && [ "${CF_UPDATE_SKIP_SETUP:-0}" -ne 1 ]; then
        print_info "Running setup script..."
        if bash "$SCRIPTS_DIR/setup.sh"; then
            print_success "Setup completed successfully"
        else
            print_warning "Setup script encountered issues, but update completed"
        fi
    else
        print_info "Skipping setup script"
    fi

    # Return to original directory
    cd "$original_dir" || true

    printf '\n'
    print_success "cf tool updated to latest version!"
    printf '%s\n' "Run 'cf help' to see all available commands"
}

# ==================== SERVE COMMAND ====================

cmd_serve() {
    local problem_name="${1:-}"
    local problems_dir="${CF_PROBLEMS_DIR:-}"

    if [ -z "$problems_dir" ]; then
        if [ -n "$problem_name" ] && [ -d "$PWD/$problem_name" ]; then
            problems_dir="$PWD"
        elif [ -n "$problem_name" ] && [ -d "$SRC_DIR/$problem_name" ]; then
            problems_dir="$SRC_DIR"
        elif [ "$PWD" != "$REPO_ROOT" ] && [ "$PWD" != "$SCRIPTS_DIR" ] && [ "$PWD" != "$SRC_DIR" ]; then
            problems_dir="$PWD"
        else
            problems_dir="$SRC_DIR"
        fi
    fi

    # Ensure absolute path
    problems_dir="$(cd "$problems_dir" 2>/dev/null && pwd || echo "$problems_dir")"

    if [ -n "$problem_name" ]; then
        if [ ! -d "$problems_dir/$problem_name" ]; then
            print_info "Problem $problem_name not found in $problems_dir. Creating from template..."
            (cd "$problems_dir" && CF_SERVE_MODE=1 cmd_template "$problem_name")
        fi
        export CF_START_PROBLEM="$problem_name"
    fi

    export CF_PROBLEMS_DIR="$problems_dir"
    export CF_SERVE_MODE=1

    print_info "Starting CF Toolkit Web Interface..."
    print_info "Problems directory: $problems_dir"

    if [ ! -d "$REPO_ROOT/web" ]; then
        error_exit "Web interface directory not found: $REPO_ROOT/web" "$EXIT_IO"
    fi

    if ! command -v npm &> /dev/null; then
        error_exit "npm not found; install Node.js 20+ to run the web workbench" "$EXIT_IO"
    fi

    cd "$REPO_ROOT/web"

    if [ ! -d "node_modules" ]; then
        print_info "Installing dependencies..."
        npm install
    fi

    # Use exec to replace the shell process and ensure signals are handled
    if [ "${CF_SERVE_PROD:-0}" -eq 1 ]; then
        print_info "Production mode: building..."
        npm run build
        exec npm run start
    fi
    exec npm run dev
}

# ==================== HELP COMMAND ====================

cmd_help() {
    cat << 'EOF'
cf - Codeforces CLI Tool

USAGE:
  cf <command> [args]
  cf [problem|file|"inline input"] [--sample N] [--input FILE] [--stdin]

COMMANDS:
  template <name> [--from T]  Create a problem directory (T: dp, graph, math, or a file)
  test [name]                 Run every sample in problem.txt, with timing
  stress [name] [-n N]        Solution vs brute.cpp on gen.cpp inputs (seed = argv[1])
  samples [name]              Print the samples parsed from problem.txt
  watch [name]                Re-run the samples whenever a source changes
  serve [name]                Start the web workbench (auto-creates the problem)
  doctor                      Check compiler, shim, timeout and web toolchain
  clean                       Remove the build cache
  update                      Pull the latest version of cf
  version                     Print the version
  help                        Show this help message

OPTIONS (run / test / stress):
  --sample N, -s N            Use sample #N (run)
  --input FILE, -i FILE       Explicit input file (run)
  --stdin                     Force interactive stdin (run)
  --checker lines|tokens      Output comparison mode (default: lines)
  --timeout SEC, -t SEC       Execution time limit (default: 5)
  -n N, --brute F, --gen F    Stress iterations / brute source / generator source
  --seed N                    First generator seed (stress)

EXAMPLES:
  cf template 1000A           Create ./1000A with solution.cpp and problem.txt
  cf template 1000A --from dp Start from templates/dp.cpp
  cf 1000A                    Compile src/1000A (or ./1000A) and run sample #1
  cf problem.txt 2            Run sample #2 from problem.txt
  cf "5\n1 2 3 4 5"           Run the solution in the cwd with inline input
  cf test                     Run all samples of the problem in the cwd
  cf test 1000A --checker tokens
  cf stress -n 1000           1000 iterations of brute.cpp vs solution.cpp
  cf watch                    Re-test on every save
  cf serve 1000A              Open the web workbench on problem 1000A

ENVIRONMENT:
  CF_REPO_ROOT        Override repository root directory
  CF_PROBLEMS_DIR     Directory containing problem folders (serve)
  CF_CXX / CXX        Compiler to use (default: g++, then clang++)
  CF_CXXFLAGS         Override compiler flags (default: -std=c++23 -O2 -Wall -Wextra)
  CF_TIMEOUT          Execution timeout in seconds (default: 5)
  CF_CHECKER          Default checker: lines or tokens
  CF_STRESS_ITERATIONS Default stress iterations (200)
  CF_BUILD_CACHE_DIR  Override build cache location
  CF_FORCE_REBUILD    Force rebuild (set to 1)
  CF_NONINTERACTIVE   Disable prompts (set to 1)
  CF_NO_EDITOR        Do not open VS Code after cf template (set to 1)
  CF_SERVE_PROD       cf serve runs a production build (set to 1)
  CF_VERBOSE          Set to 1 for debug output
  NO_COLOR            Disable colored output

FILES:
  problem.txt         Statement pasted from Codeforces; samples are parsed from Examples
  solution.cpp        Your solution (every .cpp in the directory is compiled together)
  brute.cpp, gen.cpp  Reference solution and input generator for cf stress
  samples/N.in|.out   Optional explicit sample files used when problem.txt has none
  .cfconfig           Optional shell snippet sourced for per-repo overrides

For more information, visit: https://github.com/mbn-code/cf
EOF
}

# ==================== MAIN ENTRY POINT ====================

main() {
    # Parse command
    local command="${1:-}"
    shift || true

    case "$command" in
        template|new)
            # Validate repo structure for template command
            if [ ! -d "$SRC_DIR" ]; then
                error_exit "Repository structure not found. Expected $SRC_DIR" 2
            fi
            cmd_template "$@"
            ;;
        test)
            if [ ! -d "$SRC_DIR" ]; then
                error_exit "Repository structure not found. Expected $SRC_DIR" 2
            fi
            cmd_test "$@"
            ;;
        stress)
            cmd_stress "$@"
            ;;
        samples)
            cmd_samples "$@"
            ;;
        watch)
            cmd_watch "$@"
            ;;
        serve)
            cmd_serve "$@"
            ;;
        doctor)
            cmd_doctor "$@"
            ;;
        clean)
            cmd_clean "$@"
            ;;
        update)
            cmd_update "$@"
            ;;
        version|--version|-V)
            printf 'cf %s\n' "$CF_VERSION"
            ;;
        help|--help|-h)
            cmd_help
            ;;
        "")
            # Auto-detect problem.txt if no args given
            if [ -f "$PWD/problem.txt" ]; then
                cmd_run
            else
                print_error "Usage: cf <command> [args]"
                printf '\n'
                printf '%s\n' "Commands:"
                printf '%s\n' "  cf template <name>     Create new problem template"
                printf '%s\n' "  cf [input]             Compile and run solution"
                printf '%s\n' "  cf test                Run all samples"
                printf '%s\n' "  cf stress              Solution vs brute force"
                printf '%s\n' "  cf serve               Start the web workbench"
                printf '%s\n' "  cf doctor              Check the toolchain"
                printf '%s\n' "  cf help                Show help"
                printf '\n'
                printf '%s\n' "For more information: cf help"
                return 1
            fi
            ;;
        *)
            cmd_run "$command" "$@"
            ;;
    esac
}

main "$@"
